#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift('/usr/lib/ember')
require 'ember'

cmd = ARGV.shift

begin

  case cmd

  when nil

    Ember.update_system
    Ember.update_aur

  when 'ins'

    pkgs = ARGV
    abort("Usage: emb ins <package>") if pkgs.empty?

    repo = []
    aur  = []

    pkgs.each do |pkg|
      if Ember.repo_package?(pkg)
        repo << pkg
      else
        aur << pkg
      end
    end

    unless repo.empty?
      puts "[ember] Installing repo packages: #{repo.join(' ')}"
      Ember.run("sudo pacman -S #{repo.join(' ')}")
    end

    Ember.install_aur_batch(aur) unless aur.empty?

  when 'rm'

    pkgs = ARGV
    abort("Usage: emb rm <package>") if pkgs.empty?

    Ember.run("sudo pacman -R #{pkgs.join(' ')}")

  when 'search'

    query = ARGV.shift or abort("Usage: emb search <query>")
    Ember.search(query)

  else

    abort("Unknown command: #{cmd}")

  end

rescue Interrupt
  puts "\n==> Aborted by user."
  exit 130
end
